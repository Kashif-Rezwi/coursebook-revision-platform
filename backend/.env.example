# Server Configuration
NODE_ENV=development
PORT=3001

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/learning-platform

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ChromaDB Configuration
CHROMADB_HOST=localhost
CHROMADB_PORT=8000
CHROMADB_COLLECTION=pdf_embeddings

# LLM Configuration
LLM_API_KEY=your-openai-or-anthropic-api-key
LLM_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Hugging Face Configuration
HUGGINGFACE_API_KEY=your-huggingface-api-key
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.2
HUGGINGFACE_TEMPERATURE=0.7
HUGGINGFACE_MAX_TOKENS=1024
HUGGINGFACE_TOP_P=0.9

# File Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=52428800

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Logging Configuration
LOG_LEVEL=info

# Rate Limiting Configuration
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_AUTH=5
RATE_LIMIT_STANDARD=100
RATE_LIMIT_READ=200
UPLOAD_WINDOW_MS=3600000
UPLOAD_MAX_REQUESTS=10

# Application Metadata
APP_NAME=Learning Platform API
APP_VERSION=1.0.0
